# Rebuilt inside the image.
vendor/
node_modules/

# Never bake an environment into an image.
.env
.env.*
!.env.example

# Runtime state belongs to the running container, not to the image.
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*

.git/
.github/
tests/
phpunit.xml
.phpunit.result.cache
Dockerfile
.dockerignore
