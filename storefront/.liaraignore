# Liara installs these itself.
vendor/
node_modules/

# Never upload an environment. Set these in the panel, or with `liara env:set`.
.env
.env.*
!.env.example

# Runtime state belongs to the running app.
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*

.git/
.github/
tests/
phpunit.xml
.phpunit.result.cache

# The container is the portable path, not this one. Keeping the Dockerfile out
# of the upload also keeps the CLI's platform detection from having an opinion
# about it — liara.json says laravel, and nothing should argue.
Dockerfile
.dockerignore
docker/
